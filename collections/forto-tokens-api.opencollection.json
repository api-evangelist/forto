{
  "opencollection": "1.0.0",
  "info": {
    "name": "Forto Public Bookings Tokens API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List API tokens",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.forto.com/tokens"
          },
          "docs": "List API tokens"
        },
        {
          "info": {
            "name": "Create API token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.forto.com/tokens"
          },
          "docs": "Create API token"
        },
        {
          "info": {
            "name": "Delete API token",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.forto.com/tokens/:tokenId",
            "params": [
              {
                "name": "tokenId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete API token"
        }
      ]
    }
  ],
  "bundled": true
}