{
  "opencollection": "1.0.0",
  "info": {
    "name": "Forto Public Bookings Shipments API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Shipments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List shipments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.forto.com/shipments",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List shipments"
        },
        {
          "info": {
            "name": "Retrieve shipment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.forto.com/shipments/:shipmentId",
            "params": [
              {
                "name": "shipmentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve shipment"
        }
      ]
    }
  ],
  "bundled": true
}